@{ ViewData["Title"] = "Trang chủ"; }
<div class="page-header">
    <div><h1>Quản lý sân bóng mini</h1><p>Xin chào @User.Identity?.Name. Chọn một chức năng để bắt đầu.</p></div>
    <span class="header-date">@DateTime.Today.ToString("dd/MM/yyyy")</span>
</div>
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3"><div class="summary-card"><span>Sân đang hoạt động</span><strong>@ViewBag.SoSan</strong></div></div>
    <div class="col-sm-6 col-xl-3"><div class="summary-card"><span>Khách hàng</span><strong>@ViewBag.SoKhach</strong></div></div>
    <div class="col-sm-6 col-xl-3"><div class="summary-card"><span>Lịch sân hôm nay</span><strong>@ViewBag.LichHomNay</strong></div></div>
    <div class="col-sm-6 col-xl-3"><div class="summary-card"><span>Hóa đơn chưa thanh toán</span><strong>@ViewBag.HoaDonCho</strong></div></div>
</div>
<div class="invoice-card">
    <h2 class="h4 mb-3">Thao tác nhanh</h2>
    <div class="d-flex flex-wrap gap-3">
        <a asp-controller="DatSan" asp-action="Index" class="btn btn-success">Xem lịch sân</a>
        <a asp-controller="DatSan" asp-action="Create" class="btn btn-success">Đặt sân</a>
        <a asp-controller="KhachHang" asp-action="Index" class="btn btn-outline-success">Khách hàng</a>
        <a asp-controller="HoaDon" asp-action="Index" class="btn btn-outline-success">Hóa đơn &amp; thanh toán</a>
    </div>
</div>
<div class="invoice-card"><h2 class="h4">Quy trình phục vụ</h2><p class="mb-0">Tìm hoặc thêm khách hàng → kiểm tra lịch sân → đặt sân → lập hóa đơn → xác nhận thanh toán.</p></div>
