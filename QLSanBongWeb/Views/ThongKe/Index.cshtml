@model IEnumerable<QLSanBongMini.Models.ThongKeModel>

@{
    ViewData["Title"] = "Thống kê doanh thu";
}

<h2>Thống kê doanh thu sân bóng</h2>
<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Index" method="get" class="row g-3 mb-4">
    <div class="col-auto">
        <label>Từ ngày:</label>
        <input type="date" name="tuNgay" class="form-control" value="@ViewBag.TuNgay" />
    </div>
    <div class="col-auto">
        <label>Đến ngày:</label>
        <input type="date" name="denNgay" class="form-control" value="@ViewBag.DenNgay" />
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-success">Xem thống kê</button>
    </div>
</form>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="alert alert-info">
            <h4>Tổng doanh thu: @string.Format("{0:N0} đ", ViewBag.TongDoanhThu)</h4>
        </div>
    </div>
    <div class="col-md-6">
        <div class="alert alert-secondary">
            <h4>Số hóa đơn đã thanh toán: @ViewBag.SoHoaDon</h4>
        </div>
    </div>
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Mã HĐ</th>
            <th>Ngày thanh toán</th>
            <th>Sân</th>
            <th>Tổng tiền</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaHD</td>
                <td>@item.NgayThanhToan.ToString("dd/MM/yyyy HH:mm:ss")</td>
                <td>@item.TenSan</td>
                <td>@item.TongTien.ToString("N0") đ</td>
            </tr>
        }
    </tbody>
</table>