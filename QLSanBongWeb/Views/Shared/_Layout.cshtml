@using System.Security.Claims
@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool signedIn = User.Identity?.IsAuthenticated == true;
    bool manager = User.IsInRole("Quản lý");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý sân bóng mini</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app-container">
@if (signedIn)
{
    <aside class="sidebar">
        <a class="brand text-white text-decoration-none" asp-controller="Home" asp-action="Index"><span class="brand-icon">⚽</span><span>QUẢN LÝ SÂN BÓNG</span></a>
        <nav class="sidebar-menu" aria-label="Chức năng">
            <a asp-controller="Home" asp-action="Index" class="menu-item @(currentController == "Home" ? "active" : "")">Trang chủ</a>
            <a asp-controller="DatSan" asp-action="Index" class="menu-item @(currentController == "DatSan" && currentAction == "Index" ? "active" : "")">Lịch sân</a>
            <a asp-controller="DatSan" asp-action="Create" class="menu-item @(currentController == "DatSan" && currentAction == "Create" ? "active" : "")">Đặt sân</a>
            <a asp-controller="San" asp-action="Index" class="menu-item @(currentController == "San" ? "active" : "")">Danh sách sân</a>
            <a asp-controller="KhachHang" asp-action="Index" class="menu-item @(currentController == "KhachHang" ? "active" : "")">Khách hàng</a>
            <a asp-controller="HoaDon" asp-action="Index" class="menu-item @(currentController == "HoaDon" || currentController == "ThanhToan" ? "active" : "")">Hóa đơn &amp; thanh toán</a>
            @if (manager) { <a asp-controller="ThongKe" asp-action="Index" class="menu-item @(currentController == "ThongKe" ? "active" : "")">Thống kê doanh thu</a> }
        </nav>
        <div class="sidebar-footer">
            <div class="user-name">@User.Identity?.Name</div><div>@User.FindFirstValue(ClaimTypes.Role)</div>
            <form asp-controller="Account" asp-action="Logout" method="post" class="mt-3"><button class="btn btn-sm btn-outline-light w-100" type="submit">Đăng xuất</button></form>
        </div>
    </aside>
}
    <main class="main-content @(signedIn ? "" : "login-content")">
        @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
        @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
        @RenderBody()
    </main>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
