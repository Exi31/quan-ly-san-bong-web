@model QLSanBongMini.Models.SanModel

@{
    ViewData["Title"] = "Thêm sân mới";
}

<h2>Thêm sân bóng mới</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="MaSan" class="form-label">Mã sân</label>
                <input maxlength="50" asp-for="MaSan" class="form-control" required />
                <span asp-validation-for="MaSan" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TenSan" class="form-label">Tên sân</label>
                <input maxlength="50" asp-for="TenSan" class="form-control" required />
                <span asp-validation-for="TenSan" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LoaiSan" class="form-label">Loại sân</label>
                <select asp-for="LoaiSan" class="form-control">
                    <option value="Sân 5 người">Sân 5 người</option>
                    <option value="Sân 7 người">Sân 7 người</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="GiaThueGio" class="form-label">Giá thuê/giờ (VNĐ)</label>
                <input asp-for="GiaThueGio" type="number" class="form-control" required />
                <span asp-validation-for="GiaThueGio" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="TrangThaiHoatDong" class="form-check-input" type="checkbox" checked />
                <label asp-for="TrangThaiHoatDong" class="form-check-label">Đang hoạt động</label>
            </div>

            <button type="submit" class="btn btn-success">Lưu thông tin</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>